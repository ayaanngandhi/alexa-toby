# Google Gemini API key. Required.
GEMINI_API_KEY=

# Port the HTTP server binds to. Optional, defaults to 8432.
# PORT=8432

# File to read GEMINI_API_KEY from when it is not already in the environment.
# Optional, defaults to ~/.env
# ENV_FILE=

# Shared secret accepted in an X-Api-Key header, for your own scripts and uptime checks.
# Amazon never sends this header; real Alexa traffic is authenticated by request signature instead.
# API_KEY=

# Set to 1 to reject any request that is not from Amazon or carrying a valid X-Api-Key.
# ENFORCE_SIGNATURE=0
